{
  "name": "frontier",
  "version": "1.0.0",
  "private": true,
  "description": "Frontier: a location-based land-grab game. Stand on a parcel of the real map to buy it.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build.mjs client",
    "build:server": "node scripts/build.mjs server",
    "dev": "node scripts/build.mjs client --watch & node --watch server/bin/server.ts",
    "start": "node dist/server.mjs",
    "migrate": "node dist/migrate.mjs",
    "nightly": "node dist/nightly.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json && tsc -p client/tsconfig.sw.json",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:unit": "node --test test/unit-*.test.ts",
    "icons": "node scripts/gen-icons.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "maplibre-gl": "^6.11.2",
    "playwright": "^1.63.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.9.3"
  }
}
