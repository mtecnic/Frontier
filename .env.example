# Copy to .env (next to package.json) or point ENV_FILE at it. Real environment variables win.

# Where players open the game. Used for sign-in links, passkeys and cookies.
PUBLIC_URL=https://frontier.example.com

# PostgreSQL connection.
DATABASE_URL=postgres://frontier:CHANGE_ME@localhost:5432/frontier

# The API listens here; your web server proxies /api/ to it.
HOST=127.0.0.1
PORT=8787

# Serve the built client (public/) from this process too. Set to 0 if nginx/Apache serves the folder.
SERVE_STATIC=1
STATIC_DIR=public

# Email for sign-in codes. Either an SMTP URL ...
SMTP_URL=smtp://user:password@smtp.example.com:587
# ... or the local sendmail binary (postfix, exim, msmtp):
# SENDMAIL=1
MAIL_FROM=Frontier <no-reply@frontier.example.com>

# These emails become admins when they sign in (comma separated).
ADMIN_EMAILS=you@example.com

# Nightly job (prizes, leaderboards, ledger audit) runs after this UTC hour.
NIGHTLY_HOUR_UTC=9
NIGHTLY_IN_PROCESS=1

# Optional: fixed Web Push keys (otherwise generated once and stored in the database).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional: tune game rules without code changes (see config/game.example.json).
# GAME_CONFIG=config/game.json

# Only if the API is on a different origin than the page (e.g. api.example.com):
# CORS_ORIGINS=https://frontier.example.com

# Development only. Never enable these in production.
# DEV_LOGIN=1     # returns sign-in codes in the API response
# TEST_MODE=1     # lets tests move the game clock
